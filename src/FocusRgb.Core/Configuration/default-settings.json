{
  "schemaVersion": 4,
  "application": {
    "closeButtonBehavior": "minimize-to-tray",
    "startMinimized": false,
    "theme": "system",
    "verboseLogging": false
  },
  "plugins": {
    "enabled": []
  },
  "selection": {
    "defaultProfile": "default",
    "unmatched": "default-profile",
    "debounceMs": 2000,
    "ignoredExecutables": ["ShellExperienceHost.exe", "SearchHost.exe", "LockApp.exe"]
  },
  "profiles": [
    {
      "id": "default",
      "displayName": "Default",
      "bindings": [
        {
          "id": "main",
          "plugin": "signalrgb",
          "renderingAuthority": "provider",
          "deviceScope": { "kind": "provider-managed" },
          "effect": { "resourceId": null, "displayName": "Aurora" },
          "layout": null
        }
      ],
      "fallback": [{ "kind": "native-setup" }]
    },
    {
      "id": "programming",
      "displayName": "Programming",
      "bindings": [
        {
          "id": "main",
          "plugin": "signalrgb",
          "renderingAuthority": "provider",
          "deviceScope": { "kind": "provider-managed" },
          "effect": { "resourceId": null, "displayName": "Aurora" },
          "layout": null
        }
      ],
      "fallback": [{ "kind": "native-setup" }]
    },
    {
      "id": "movie",
      "displayName": "Movie",
      "bindings": [
        {
          "id": "main",
          "plugin": "signalrgb",
          "renderingAuthority": "provider",
          "deviceScope": { "kind": "provider-managed" },
          "effect": { "resourceId": null, "displayName": "Screen Ambient" },
          "layout": null
        }
      ],
      "fallback": [{ "kind": "native-setup" }]
    },
    {
      "id": "music",
      "displayName": "Music",
      "bindings": [
        {
          "id": "main",
          "plugin": "signalrgb",
          "renderingAuthority": "provider",
          "deviceScope": { "kind": "provider-managed" },
          "effect": { "resourceId": null, "displayName": "Logarithmic Visualizer" },
          "layout": null
        }
      ],
      "fallback": [{ "kind": "native-setup" }]
    }
  ],
  "applicationGroups": [
    {
      "id": "programming",
      "displayName": "Programming",
      "executables": ["Code.exe", "devenv.exe"]
    },
    {
      "id": "movie",
      "displayName": "Movie",
      "executables": ["PotPlayerMini64.exe", "PotPlayerMini.exe", "stremio-shell-ng.exe"]
    },
    {
      "id": "music",
      "displayName": "Music",
      "executables": ["Microsoft.Media.Player.exe", "wmplayer.exe", "Spotify.exe"]
    }
  ],
  "rules": [
    {
      "id": "programming",
      "profile": "programming",
      "applicationGroup": "programming",
      "eligibility": "while-focused",
      "enabled": true
    },
    {
      "id": "movie",
      "profile": "movie",
      "applicationGroup": "movie",
      "eligibility": "while-focused",
      "enabled": true
    },
    {
      "id": "music",
      "profile": "music",
      "applicationGroup": "music",
      "eligibility": "while-focused",
      "enabled": true
    }
  ]
}
