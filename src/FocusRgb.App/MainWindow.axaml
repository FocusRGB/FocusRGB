<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusRgb.App.ViewModels"
        x:Class="FocusRgb.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FocusRGB" Width="1040" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="22,16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="FocusRGB" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Lighting profiles that follow what you do" Opacity="0.65" />
        </StackPanel>
        <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="#253B82F6">
          <TextBlock Text="UI preview · no hardware output" Foreground="#93C5FD" />
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="12">
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="20" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Overview" FontSize="26" FontWeight="SemiBold" />
            <Border Padding="20" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="14">
                <TextBlock Text="Selection mode" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton Content="Manual" GroupName="SelectionMode" IsChecked="{Binding IsManual}" />
                  <RadioButton Content="Automatic" GroupName="SelectionMode" IsChecked="{Binding IsAutomatic}" />
                </StackPanel>
                <TextBlock Text="Profile" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Padding="20" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                <TextBlock Grid.Row="0" Text="Desired profile" Opacity="0.65" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesiredProfileName}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Applied profile" Opacity="0.65" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppliedProfileName}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="Reason" Opacity="0.65" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectionReason}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Profiles">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Each profile contains exactly one effect and one layout." Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditingProfile}"
                      PlaceholderText="No profiles available">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Border IsVisible="{Binding HasEditingProfile}" Padding="16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Name" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding ProfileName}" />
                  <TextBlock Grid.Row="1" Text="Effect" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProfileEffect}" />
                  <TextBlock Grid.Row="2" Text="Layout" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProfileLayout}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save" Click="SaveProfile_OnClick" />
                  <Button Content="Save As" Click="SaveProfileAs_OnClick" />
                  <Button Content="Remove" Click="RemoveProfile_OnClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ProfileEditorStatus}" Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Application Groups">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Application Groups" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Name a group and add one or more Windows executables." Opacity="0.7" />
            <ComboBox ItemsSource="{Binding ApplicationGroups}" SelectedItem="{Binding EditingApplicationGroup}"
                      PlaceholderText="No application groups available">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ApplicationGroupViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button IsVisible="{Binding HasNoEditingApplicationGroup}" Content="Save As"
                    Click="SaveApplicationGroupAs_OnClick" HorizontalAlignment="Left" />
            <Border IsVisible="{Binding HasEditingApplicationGroup}" Padding="16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBox Text="{Binding ApplicationGroupName}" PlaceholderText="Application group name" />
                <ListBox ItemsSource="{Binding DraftExecutables}" SelectedItem="{Binding SelectedDraftExecutable}" MinHeight="70" MaxHeight="180" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Add application…" Click="BrowseExecutable_OnClick" />
                  <Button Content="Remove application" Click="RemoveExecutable_OnClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save" Click="SaveApplicationGroup_OnClick" />
                  <Button Content="Save As" Click="SaveApplicationGroupAs_OnClick" />
                  <Button Content="Remove" Click="RemoveApplicationGroup_OnClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ApplicationGroupEditorStatus}" Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Mappings">
        <Grid Margin="24,16" RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="Application mappings" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Top row has highest priority. Drag rows or use the hover arrows." Opacity="0.7" /></StackPanel>
            <CheckBox Grid.Column="1" Content="Live preview" IsChecked="{Binding MappingEditor.LivePreview}" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="16">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
            <ListBox Grid.Row="0" ItemsSource="{Binding MappingEditor.Mappings}" SelectedItem="{Binding MappingEditor.SelectedMapping}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem:not(:pointerover) StackPanel.row-actions"><Setter Property="IsVisible" Value="False" /></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MappingEditorItemViewModel">
                  <StackPanel>
                    <Border Height="8" Background="Transparent" DragDrop.AllowDrop="True"
                            DragDrop.DragOver="MappingRow_OnDragOver" DragDrop.Drop="MappingBefore_OnDrop" />
                    <Grid Margin="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                          PointerPressed="MappingDrag_OnPointerPressed" ToolTip.Tip="Drag this row to reorder">
                      <TextBlock Text="{Binding Position}" VerticalAlignment="Center" Opacity="0.55" />
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding SelectedApplicationGroup.DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="12" Opacity="0.65" /></StackPanel>
                      <StackPanel Grid.Column="2" Classes="row-actions" Orientation="Horizontal" Spacing="3">
                        <Button Content="↑" Padding="7,3" CommandParameter="{Binding}" Click="MoveMappingUp_OnClick" ToolTip.Tip="Move up" />
                        <Button Content="↓" Padding="7,3" CommandParameter="{Binding}" Click="MoveMappingDown_OnClick" ToolTip.Tip="Move down" />
                        <Button Content="Edit" Padding="7,3" CommandParameter="{Binding}" Click="EditMapping_OnClick" />
                        <Button Content="Remove" Padding="7,3" CommandParameter="{Binding}" Click="RemoveMapping_OnClick" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="1" Height="18" Background="#12000000" CornerRadius="4"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="MappingRow_OnDragOver"
                    DragDrop.Drop="MappingEnd_OnDrop" ToolTip.Tip="Drop here to move to the end">
              <TextBlock Text="Drop at end" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Opacity="0.55" />
            </Border>
            <StackPanel Grid.Row="2" Spacing="6">
              <TextBlock Text="Create mapping" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ApplicationGroups}" SelectedItem="{Binding MappingEditor.NewApplicationGroup}" PlaceholderText="No application groups available">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ApplicationGroupViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding MappingEditor.NewProfile}" PlaceholderText="No profiles available">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Save As" Click="SaveMappingAs_OnClick" HorizontalAlignment="Left" />
            </StackPanel>
            </Grid>
            <Border Grid.Column="1" Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <ContentControl Content="{Binding MappingEditor.SelectedMapping}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MappingEditorItemViewModel">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Mapping details" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="Application group" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding ApplicationGroups}" SelectedItem="{Binding SelectedApplicationGroup}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ApplicationGroupViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock Text="Profile" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock Text="Eligibility" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding EligibilityOptions}" SelectedItem="{Binding Eligibility}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Border>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="{Binding MappingEditor.PreviewStatus}" /><TextBlock Text="Unsaved draft" IsVisible="{Binding MappingEditor.IsDirty}" Foreground="#FBBF24" FontWeight="SemiBold" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Cancel" Click="CancelMappings_OnClick" /><Button Content="Save" Click="ApplyMappings_OnClick" /></StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Integrations"><StackPanel Margin="28,16" Spacing="10"><TextBlock Text="Integrations" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="No plugins connected. Integrations run as separate processes." /></StackPanel></TabItem>
      <TabItem Header="Devices" IsEnabled="False" />
      <TabItem Header="Settings" IsEnabled="False" />
    </TabControl>
  </Grid>
</Window>
