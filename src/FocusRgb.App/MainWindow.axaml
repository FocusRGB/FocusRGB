<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusRgb.App.ViewModels"
        x:Class="FocusRgb.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FocusRGB" Width="1040" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Padding="22,16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="FocusRGB" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Lighting profiles that follow what you do" Opacity="0.65" />
        </StackPanel>
        <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="#253B82F6">
          <TextBlock Text="Local runtime · coordinated plugin output" Foreground="{DynamicResource ThemeForegroundBrush}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" IsVisible="{Binding HasSettingsConflict}" Margin="12,10,12,0" Padding="12"
            CornerRadius="8" BorderBrush="#F59E0B" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Settings changed elsewhere. Reload before saving the current editor draft."
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Reload settings" Click="ReloadSettings_OnClick" />
      </Grid>
    </Border>

    <Border x:Name="McpApprovalPanel" Grid.Row="2" IsVisible="False" Margin="12,10,12,0" Padding="14"
            CornerRadius="8" BorderBrush="#3B82F6" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <TextBlock Text="Local MCP approval" FontWeight="SemiBold" />
          <TextBlock x:Name="McpApprovalDetailsText" Opacity="0.7" TextWrapping="Wrap" />
          <TextBlock x:Name="McpApprovalSummaryText" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Decline" Click="DeclineMcpApproval_OnClick" />
          <Button Content="Approve" Click="ApproveMcpApproval_OnClick" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="3" TabStripPlacement="Left" Margin="12"
                SelectionChanged="MainTabs_OnSelectionChanged">
      <TabItem Header="Home">
        <Grid Margin="24,16" RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Home" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" Padding="14,8" CornerRadius="8"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" />
                <RadioButton Content="Manual" GroupName="SelectionMode"
                             IsChecked="{Binding IsManual, Mode=OneWay}" IsCheckedChanged="ManualMode_OnClick" />
                <RadioButton Content="Automatic" GroupName="SelectionMode"
                             IsChecked="{Binding IsAutomatic, Mode=OneWay}" IsCheckedChanged="AutomaticMode_OnClick" />
              </StackPanel>
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsManual}">
            <StackPanel Spacing="20" MaxWidth="680" HorizontalAlignment="Left">
              <Border Padding="20" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                  <TextBlock Text="Profile" FontSize="18" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=OneWay}"
                            IsEnabled="{Binding !IsRuntimeCommandPending}"
                            AutomationProperties.Name="Selected lighting profile"
                            SelectionChanged="SelectedProfile_OnSelectionChanged"
                            PlaceholderText="No profiles available">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>
              <Border Padding="20" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                  <TextBlock Text="Desired profile" Opacity="0.65" /><TextBlock Grid.Column="1" Text="{Binding DesiredProfileName}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="Applied profile" Opacity="0.65" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppliedProfileName}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="2" Text="Reason" Opacity="0.65" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectionReason}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Runtime" Opacity="0.65" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeStatusMessage}" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding StartupStatusMessage}" IsVisible="{Binding HasStartupStatus}"
                         Opacity="0.7" TextWrapping="Wrap" />
              <Border IsVisible="{Binding HasRecoveryNotification}" Padding="16" CornerRadius="8"
                      BorderBrush="#F59E0B" BorderThickness="1">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding RecoveryNotificationMessage}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Accept" Click="AcceptRecovery_OnClick" IsEnabled="{Binding !IsRuntimeCommandPending}" />
                    <Button Content="Decline" Click="DeclineRecovery_OnClick" IsEnabled="{Binding !IsRuntimeCommandPending}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="1" IsVisible="{Binding IsAutomatic}" RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Application and game mappings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Top row has highest priority. Drag rows or use the arrow buttons." Opacity="0.7" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="Live preview" IsChecked="{Binding MappingEditor.LivePreview}" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="16">
              <Grid RowDefinitions="*,Auto" RowSpacing="8">
                <ListBox ItemsSource="{Binding MappingEditor.Mappings}" SelectedItem="{Binding MappingEditor.SelectedMapping}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MappingEditorItemViewModel">
                        <Grid Margin="4" MinHeight="30" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              AutomationProperties.Name="{Binding AccessibleName}"
                              PointerPressed="MappingDrag_OnPointerPressed" ToolTip.Tip="Drag this row to reorder"
                              DragDrop.AllowDrop="True" DragDrop.DragOver="MappingRow_OnDragOver"
                              DragDrop.Drop="MappingRow_OnDrop">
                          <TextBlock Text="{Binding Position}" VerticalAlignment="Center" Opacity="0.55" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding SelectedTarget.DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="12" Opacity="0.65" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Classes="row-actions" Orientation="Horizontal" Spacing="3">
                            <Button Content="↑" Padding="7,3" CommandParameter="{Binding}" Click="MoveMappingUp_OnClick" ToolTip.Tip="Move up"
                                    AutomationProperties.Name="{Binding MoveUpAccessibleName}" />
                            <Button Content="↓" Padding="7,3" CommandParameter="{Binding}" Click="MoveMappingDown_OnClick" ToolTip.Tip="Move down"
                                    AutomationProperties.Name="{Binding MoveDownAccessibleName}" />
                            <Button Content="Edit" Padding="7,3" CommandParameter="{Binding}" Click="EditMapping_OnClick"
                                    AutomationProperties.Name="{Binding EditAccessibleName}" />
                            <Button Content="Remove" Padding="7,3" CommandParameter="{Binding}" Click="RemoveMapping_OnClick"
                                    AutomationProperties.Name="{Binding RemoveAccessibleName}" />
                          </StackPanel>
                        </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Spacing="6">
                  <TextBlock Text="Create mapping" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding MappingEditor.Targets}" SelectedItem="{Binding MappingEditor.NewTarget}"
                            AutomationProperties.Name="New mapping target"
                            PlaceholderText="No mapping targets available">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MappingTargetViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding MappingEditor.NewProfile}"
                            AutomationProperties.Name="New mapping profile"
                            PlaceholderText="No profiles available">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="Save As" Click="SaveMappingAs_OnClick" HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
              <Border Grid.Column="1" Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
                <ContentControl Content="{Binding MappingEditor.SelectedMapping}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:MappingEditorItemViewModel">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Mapping details" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Application or game" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                  AutomationProperties.Name="Mapping application or game">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MappingTargetViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Profile" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  AutomationProperties.Name="Mapping profile">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Eligibility" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding EligibilityOptions}" SelectedItem="{Binding Eligibility}"
                                  AutomationProperties.Name="Mapping eligibility" />
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding MappingEditor.PreviewStatus}" />
                <TextBlock Text="Unsaved draft" IsVisible="{Binding MappingEditor.IsDirty}" Foreground="#FBBF24" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="CancelMappings_OnClick" />
                <Button Content="Save" Click="ApplyMappings_OnClick" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Profiles">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold" />
              <CheckBox Grid.Column="1" Content="Live preview" IsChecked="{Binding ProfileLivePreview}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Each profile contains exactly one effect and one layout." Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding EditingProfile}"
                      AutomationProperties.Name="Profile to edit"
                      IsEnabled="{Binding !IsSettingsSavePending}" PlaceholderText="No profiles available">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Border IsVisible="{Binding HasEditingProfile}" Padding="16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Name" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding ProfileName}" />
                  <TextBlock Grid.Row="1" Text="Effect" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProfileEffectOptions}"
                            SelectedItem="{Binding SelectedProfileEffect}"
                            AutomationProperties.Name="Provider effect" PlaceholderText="No provider effects available">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProviderResourceOptionViewModel"><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="2" Text="Layout" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ProfileLayoutOptions}"
                            SelectedItem="{Binding SelectedProfileLayout}"
                            AutomationProperties.Name="Provider layout" PlaceholderText="No provider layouts available">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProviderResourceOptionViewModel"><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock Text="{Binding ProfileResourceStatus}" Opacity="0.7" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Fallback" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileFallbackKinds}" SelectedItem="{Binding ProfileFallbackKind}"
                            AutomationProperties.Name="Fallback kind" />
                  <TextBlock Grid.Row="1" Text="Fallback profile" VerticalAlignment="Center" IsVisible="{Binding IsProfileFallback}" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding ProfileFallbackProfile}" IsVisible="{Binding IsProfileFallback}"
                            AutomationProperties.Name="Fallback profile"
                            PlaceholderText="Select a fallback profile">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProfileOptionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsSettingsSavePending}">
                  <Button Content="Save" Click="SaveProfile_OnClick" />
                  <Button Content="Save As" Click="SaveProfileAs_OnClick" />
                  <Button Content="Cancel" Click="CancelProfile_OnClick" />
                  <Button Content="Remove" Click="RemoveProfile_OnClick" IsEnabled="{Binding CanRemoveEditingProfile}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ProfileEditorStatus}" Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Application Groups">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
            <TextBlock Text="Application Groups" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Name a group and add one or more Windows executables." Opacity="0.7" />
            <ComboBox ItemsSource="{Binding ApplicationGroups}" SelectedItem="{Binding EditingApplicationGroup}"
                      AutomationProperties.Name="Application group to edit"
                      PlaceholderText="No application groups available">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ApplicationGroupViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button IsVisible="{Binding HasNoEditingApplicationGroup}" Content="Save As"
                    Click="SaveApplicationGroupAs_OnClick" HorizontalAlignment="Left" />
            <Border IsVisible="{Binding HasEditingApplicationGroup}" Padding="16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBox Text="{Binding ApplicationGroupName}"
                         AutomationProperties.Name="Application group name"
                         PlaceholderText="Application group name" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ListBox ItemsSource="{Binding DraftExecutables}" SelectedItem="{Binding SelectedDraftExecutable}" MinHeight="70" MaxHeight="180" />
                  <StackPanel Grid.Column="1" Spacing="8">
                    <Button Content="Add application…" Click="BrowseExecutable_OnClick" />
                    <Button Content="Remove application" Click="RemoveExecutable_OnClick" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding DetectedExecutables}"
                            SelectedItem="{Binding SelectedDetectedExecutable}"
                            AutomationProperties.Name="Detected running application"
                            PlaceholderText="Choose a running application" />
                  <Button Grid.Column="1" Content="Add detected" Click="AddDetectedExecutable_OnClick" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ManualExecutable}"
                           AutomationProperties.Name="Manual executable name"
                           PlaceholderText="Enter executable name, for example app.exe" />
                  <Button Grid.Column="1" Content="Add name" Click="AddManualExecutable_OnClick" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save" Click="SaveApplicationGroup_OnClick" />
                  <Button Content="Save As" Click="SaveApplicationGroupAs_OnClick" />
                  <Button Content="Remove" Click="RemoveApplicationGroup_OnClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ApplicationGroupEditorStatus}" Opacity="0.7" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Games">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Games" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Discovered executables are cached so mappings keep working while a discovery plugin is offline."
                           Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="New manual game" Click="NewManualGame_OnClick" />
            </Grid>
            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding EditingGame}"
                      AutomationProperties.Name="Game to inspect or edit"
                      PlaceholderText="No games have been added or discovered">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GameCatalogItemViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayLabel}" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.65" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding EditingGame.Status}" Opacity="0.7" TextWrapping="Wrap" />
            <Border Padding="16" CornerRadius="8"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBox Text="{Binding GameName}" AutomationProperties.Name="Manual game name"
                         PlaceholderText="Game name" IsReadOnly="{Binding !CanEditGame}" />
                <ListBox x:Name="GameExecutableList" ItemsSource="{Binding DraftGameExecutables}"
                         SelectedItem="{Binding SelectedGameExecutable}"
                         AutomationProperties.Name="Game executables" MinHeight="70" />
                <StackPanel x:Name="GameEditControls" Spacing="10" IsEnabled="{Binding CanEditGame}">
                  <Button Content="Add executable…" Click="BrowseGameExecutable_OnClick" HorizontalAlignment="Left" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding DetectedExecutables}"
                              SelectedItem="{Binding SelectedDetectedExecutable}"
                              AutomationProperties.Name="Detected running game"
                              PlaceholderText="Choose a running application" />
                    <Button Grid.Column="1" Content="Add detected" Click="AddDetectedGameExecutable_OnClick" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ManualGameExecutable}"
                             AutomationProperties.Name="Manual game executable"
                             PlaceholderText="Enter executable name, for example game.exe" />
                    <Button Grid.Column="1" Content="Add name" Click="AddManualGameExecutable_OnClick" />
                  </Grid>
                  <Button Content="Remove executable" Click="RemoveGameExecutable_OnClick" />
                  <Button Content="Save" Click="SaveManualGame_OnClick" />
                </StackPanel>
                <Button Content="Remove game" Click="RemoveManualGame_OnClick"
                        IsEnabled="{Binding CanRemoveGame}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding GameEditorStatus}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Plugins">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Plugins" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Official discovery contacts GitHub only when this page opens or you refresh it."
                           Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Refresh" Click="RefreshPlugins_OnClick" />
            </Grid>
            <TextBlock Text="{Binding PluginsStatus}" TextWrapping="Wrap" />

            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Installed" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledPluginItemViewModel">
                      <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                              BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Id}" Opacity="0.65" />
                            <TextBlock Text="{Binding Version}" Opacity="0.65" />
                            <TextBlock Text="{Binding Origin}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Enable" IsEnabled="{Binding CanEnable}"
                                    CommandParameter="{Binding}" Click="EnablePlugin_OnClick" />
                            <Button Content="Disable" IsEnabled="{Binding CanDisable}"
                                    CommandParameter="{Binding}" Click="DisablePlugin_OnClick" />
                            <Button Content="Uninstall" CommandParameter="{Binding}" Click="UninstallPlugin_OnClick" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Official plugins" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding OfficialPlugins}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OfficialPluginItemViewModel">
                      <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                              BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Opacity="0.65" />
                            <TextBlock Text="{Binding Contract}" Opacity="0.65" />
                            <TextBlock Text="{Binding Resources}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Compatibility}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Source}" Opacity="0.65" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="Install" IsEnabled="{Binding CanInstall}"
                                  CommandParameter="{Binding}" Click="InstallOfficialPlugin_OnClick"
                                  VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Custom plugins" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Custom plugins are unverified and run with your full user permissions."
                           TextWrapping="Wrap" />
                <Button Content="Choose a plugin ZIP…" HorizontalAlignment="Left"
                        Click="InstallCustomZip_OnClick" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox PlaceholderText="owner/repo or https://github.com/owner/repo"
                           Text="{Binding CustomPluginGitHubUrl}" />
                  <Button Grid.Column="1" Content="Install from GitHub"
                          Click="InstallCustomGitHub_OnClick" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Devices" IsEnabled="False" />
      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel Margin="28,16" Spacing="18" MaxWidth="720" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />
            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="Close button" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding CloseButtonBehaviors}"
                            AutomationProperties.Name="Close button behavior"
                            SelectedItem="{Binding CloseButtonBehavior}" />
                  <TextBlock Grid.Row="1" Text="Start minimized" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding StartMinimized}"
                            Content="Hide in the tray after launch" />
                </Grid>
                <TextBlock Text="Start minimized does not register FocusRGB to start with Windows."
                           Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                  <TextBlock Text="Theme" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ApplicationThemes}"
                            AutomationProperties.Name="Application theme"
                            SelectedItem="{Binding ApplicationTheme}"
                            SelectionChanged="ApplicationTheme_OnSelectionChanged" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="12">
                <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" />
                <CheckBox IsChecked="{Binding VerboseLogging}"
                          Content="Enable basic diagnostic logging" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Open settings folder" Click="OpenSettingsFolder_OnClick" />
                  <Button Content="Open logs folder" Click="OpenLogsFolder_OnClick" />
                  <Button Content="Export diagnostics…" Click="ExportDiagnostics_OnClick" />
                </StackPanel>
                <TextBlock Text="Diagnostic exports contain application/runtime metadata only; profiles, mappings, paths, and secrets are excluded."
                           Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="Local MCP" FontSize="18" FontWeight="SemiBold" />
                <CheckBox x:Name="McpEnabledCheckBox" Content="Enable local MCP tools"
                          Click="McpEnabled_OnClick" />
                <TextBlock x:Name="McpStatusText" TextWrapping="Wrap" Opacity="0.65" />
                <TextBlock Text="Off means no local pipe. MCP cannot change this switch."
                           TextWrapping="Wrap" Opacity="0.65" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding ApplicationSettingsStatus}" TextWrapping="Wrap" />
                <TextBlock Text="Unsaved draft" IsVisible="{Binding IsApplicationSettingsDirty}"
                           Foreground="#FBBF24" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="CancelApplicationSettings_OnClick" />
                <Button Content="Save" Click="SaveApplicationSettings_OnClick" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
