<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FocusRgb.Plugin.Template</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FocusRgb.PluginSdk" Version="1.0.0" />
    <None Update="focusrgb-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
