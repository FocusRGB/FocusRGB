{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FocusRGB/FocusRGB/spec-v1.3.0/sdk/spec/plugin-protocol.schema.json",
  "title": "FocusRGB newline JSON-RPC message",
  "oneOf": [
    { "$ref": "#/$defs/requests" },
    { "$ref": "#/$defs/notifications" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": { "properties": { "method": { "enum": ["initialize", "status/get", "catalog/list", "binding/apply", "binding/release", "effect/input", "shutdown"] } } },
    "notification": { "properties": { "method": { "enum": ["status/changed", "game/telemetry", "$/cancel"] } } },
    "requests": {
      "anyOf": [
        { "$ref": "#/$defs/initializeRequest" }, { "$ref": "#/$defs/statusGetRequest" },
        { "$ref": "#/$defs/catalogListRequest" }, { "$ref": "#/$defs/bindingApplyRequest" },
        { "$ref": "#/$defs/bindingReleaseRequest" }, { "$ref": "#/$defs/effectInputRequest" },
        { "$ref": "#/$defs/shutdownRequest" }
      ]
    },
    "initializeRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "initialize" }, "params": { "$ref": "#/$defs/initializeParameters" } }
    },
    "statusGetRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "status/get" }, "params": { "$ref": "#/$defs/emptyObject" } }
    },
    "catalogListRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "catalog/list" }, "params": { "$ref": "#/$defs/catalogListParameters" } }
    },
    "bindingApplyRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "binding/apply" }, "params": { "$ref": "#/$defs/bindingApplyParameters" } }
    },
    "bindingReleaseRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "binding/release" }, "params": { "$ref": "#/$defs/bindingReleaseParameters" } }
    },
    "effectInputRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "effect/input" }, "params": { "$ref": "#/$defs/effectInputParameters" } }
    },
    "shutdownRequest": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": "integer" }, "method": { "const": "shutdown" }, "params": { "$ref": "#/$defs/emptyObject" } }
    },
    "notifications": {
      "anyOf": [
        { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "status/changed" }, "params": { "$ref": "#/$defs/emptyObject" } } },
        { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "game/telemetry" }, "params": { "$ref": "#/$defs/gameTelemetryParameters" } } },
        { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "$/cancel" }, "params": { "$ref": "#/$defs/cancelParameters" } } }
      ]
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" }, "id": { "type": ["integer", "null"] },
        "result": { "anyOf": [
          { "$ref": "#/$defs/initializeResult" }, { "$ref": "#/$defs/pluginStatusResult" },
          { "$ref": "#/$defs/pluginCatalogResult" }, { "$ref": "#/$defs/bindingApplyResult" },
          { "$ref": "#/$defs/bindingReleaseResult" }, { "$ref": "#/$defs/effectInputResult" },
          { "$ref": "#/$defs/emptyObject" }
        ] },
        "error": { "$ref": "#/$defs/rpcError" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    },
    "emptyObject": { "type": "object", "additionalProperties": false },
    "rpcError": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "integer" }, "message": { "type": "string" } } },
    "pluginHostInfo": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } },
    "initializeParameters": {
      "type": "object", "additionalProperties": false, "required": ["contractVersion", "host"],
      "properties": { "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }, "host": { "$ref": "#/$defs/pluginHostInfo" } }
    },
    "initializeResult": {
      "type": "object", "additionalProperties": false, "required": ["pluginId", "pluginVersion", "contractVersion", "capabilities"],
      "properties": {
        "pluginId": { "type": "string" }, "pluginVersion": { "type": "string" }, "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/pluginCapability" } },
        "sdk": { "$ref": "#/$defs/pluginSdkInfo" }
      }
    },
    "pluginSdkInfo": {
      "type": "object", "additionalProperties": false, "required": ["name", "language", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "pluginCapability": { "type": "object", "additionalProperties": false, "required": ["id", "support"], "properties": { "id": { "type": "string" }, "support": { "type": "string" }, "reason": { "$ref": "#/$defs/pluginReason" } } },
    "pluginReason": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
    "pluginStatusResult": { "type": "object", "additionalProperties": false, "required": ["availability"], "properties": { "availability": { "type": "string" }, "reason": { "$ref": "#/$defs/pluginReason" }, "current": { "$ref": "#/$defs/pluginSelection" } } },
    "pluginSelection": { "type": "object", "additionalProperties": false, "properties": { "effect": { "$ref": "#/$defs/pluginResourceReference" }, "layout": { "$ref": "#/$defs/pluginResourceReference" } } },
    "pluginResourceReference": { "type": "object", "additionalProperties": false, "required": ["displayName"], "properties": { "resourceId": { "type": "string" }, "displayName": { "type": "string" } } },
    "catalogListParameters": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["effect", "layout", "game", "telemetry"] } } },
    "pluginCatalogResult": {
      "type": "object", "additionalProperties": false, "required": ["support", "items"],
      "properties": { "support": { "type": "string" }, "refreshedAt": { "type": "string", "format": "date-time" }, "items": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/pluginCatalogItem" } }, "reason": { "$ref": "#/$defs/pluginReason" } }
    },
    "pluginCatalogItem": { "type": "object", "additionalProperties": false, "required": ["resourceId", "displayName", "available"], "properties": { "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "displayName": { "type": "string", "minLength": 1, "maxLength": 128 }, "available": { "type": "boolean" }, "reason": { "$ref": "#/$defs/pluginReason" }, "game": { "$ref": "#/$defs/pluginGameCatalogMetadata" }, "telemetry": { "$ref": "#/$defs/pluginTelemetryCatalogMetadata" } }, "dependentSchemas": { "telemetry": { "properties": { "resourceId": { "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" } } } } },
    "pluginGameCatalogMetadata": { "type": "object", "additionalProperties": false, "required": ["executables"], "properties": { "executables": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" } } } },
    "pluginGameReference": { "type": "object", "additionalProperties": false, "required": ["launcher", "id"], "properties": { "launcher": { "type": "string", "minLength": 1, "maxLength": 64 }, "id": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "pluginTelemetrySection": { "type": "object", "additionalProperties": false, "required": ["id", "displayName", "order"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 64 }, "displayName": { "type": "string", "minLength": 1, "maxLength": 128 }, "order": { "type": "integer" } } },
    "pluginTelemetryChoice": { "type": "object", "additionalProperties": false, "required": ["value", "displayName"], "properties": { "value": { "type": "string", "maxLength": 256 }, "displayName": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "pluginTelemetryCatalogMetadata": {
      "type": "object", "additionalProperties": false, "required": ["game", "section", "kind", "valueType", "description"],
      "properties": {
        "game": { "$ref": "#/$defs/pluginGameReference" }, "section": { "$ref": "#/$defs/pluginTelemetrySection" },
        "kind": { "type": "string", "enum": ["input", "event"] }, "valueType": { "type": "string", "enum": ["boolean", "number", "string", "event"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 }, "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "minimum": { "type": "number" }, "maximum": { "type": "number" },
        "choices": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/pluginTelemetryChoice" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "event" } } }, "then": { "properties": { "valueType": { "const": "event" } } } },
        { "if": { "properties": { "valueType": { "const": "event" } } }, "then": { "properties": { "kind": { "const": "event" } } } },
        { "if": { "properties": { "valueType": { "const": "number" } } }, "else": { "not": { "anyOf": [{ "required": ["minimum"] }, { "required": ["maximum"] }] } } },
        { "if": { "properties": { "valueType": { "const": "string" } } }, "else": { "not": { "required": ["choices"] } } }
      ]
    },
    "pluginTelemetrySource": { "type": "object", "additionalProperties": false, "required": ["game", "adapter"], "properties": { "game": { "$ref": "#/$defs/pluginGameReference" }, "adapter": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" } } },
    "pluginTelemetryValue": {
      "type": "object", "additionalProperties": false, "required": ["resourceId"],
      "properties": { "resourceId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" }, "boolean": { "type": "boolean" }, "number": { "type": "number" }, "string": { "type": "string", "maxLength": 1024 } },
      "oneOf": [{ "required": ["boolean"] }, { "required": ["number"] }, { "required": ["string"] }]
    },
    "pluginTelemetryEvent": { "type": "object", "additionalProperties": false, "required": ["resourceId", "observedAt", "values"], "properties": { "resourceId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" }, "observedAt": { "type": "string", "format": "date-time" }, "values": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/pluginTelemetryValue" } } } },
    "gameTelemetryParameters": {
      "type": "object", "additionalProperties": false, "required": ["source", "sequence", "observedAt", "freshForMs", "disconnectAfterMs", "inputs", "events"],
      "properties": {
        "source": { "$ref": "#/$defs/pluginTelemetrySource" }, "sequence": { "type": "integer", "minimum": 0 },
        "observedAt": { "type": "string", "format": "date-time" }, "freshForMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "disconnectAfterMs": { "type": "integer", "minimum": 101, "maximum": 300000 },
        "inputs": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/pluginTelemetryValue" } },
        "events": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/pluginTelemetryEvent" } }
      }
    },
    "pluginDeviceScope": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string" }, "deviceIds": { "type": "array", "items": { "type": "string" } } } },
    "bindingApplyParameters": {
      "type": "object", "additionalProperties": false, "required": ["profile", "bindingId", "renderingAuthority", "deviceScope"],
      "properties": { "profile": { "type": "string" }, "bindingId": { "type": "string" }, "renderingAuthority": { "type": "string" }, "deviceScope": { "$ref": "#/$defs/pluginDeviceScope" }, "effect": { "$ref": "#/$defs/pluginResourceReference" }, "layout": { "$ref": "#/$defs/pluginResourceReference" } }
    },
    "bindingApplyResult": { "type": "object", "additionalProperties": false, "required": ["outcome"], "properties": { "outcome": { "type": "string" }, "reason": { "$ref": "#/$defs/pluginReason" }, "actual": { "$ref": "#/$defs/pluginSelection" } } },
    "bindingReleaseParameters": { "type": "object", "additionalProperties": false, "required": ["profile", "bindingId"], "properties": { "profile": { "type": "string" }, "bindingId": { "type": "string" } } },
    "bindingReleaseResult": { "type": "object", "additionalProperties": false, "required": ["outcome"], "properties": { "outcome": { "type": "string" } } },
    "effectInputParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "bindingId", "mappingId", "sourcePluginId", "source", "sourceResourceId", "sequence", "receivedAt", "freshness", "conditionMatched", "targetInputId"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 }, "bindingId": { "type": "string", "minLength": 1, "maxLength": 128 }, "mappingId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sourcePluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "source": { "$ref": "#/$defs/pluginTelemetrySource" }, "sourceResourceId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" }, "sequence": { "type": "integer", "minimum": 0 }, "receivedAt": { "type": "string", "format": "date-time" },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "disconnected"] }, "conditionMatched": { "type": "boolean" }, "targetInputId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "$ref": "#/$defs/pluginTelemetryValue" }, "event": { "$ref": "#/$defs/pluginTelemetryEvent" }
      },
      "allOf": [
        { "if": { "properties": { "freshness": { "const": "fresh" } } }, "then": { "oneOf": [{ "required": ["value"], "not": { "required": ["event"] } }, { "required": ["event"], "not": { "required": ["value"] } }] } },
        { "if": { "properties": { "freshness": { "enum": ["stale", "disconnected"] } } }, "then": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["event"] }] } } }
      ]
    },
    "effectInputResult": { "type": "object", "additionalProperties": false, "required": ["outcome"], "properties": { "outcome": { "type": "string", "enum": ["accepted", "unsupported", "unavailable"] }, "reason": { "$ref": "#/$defs/pluginReason" } } },
    "cancelParameters": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "integer" } } }
  }
}
