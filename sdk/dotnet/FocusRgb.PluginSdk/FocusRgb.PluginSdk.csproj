<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FocusRgb.PluginSdk</PackageId>
    <Version>1.0.0</Version>
    <Description>Optional .NET process-plugin SDK for the stable FocusRGB 1.x JSON-RPC protocol.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/FocusRGB/FocusRGB</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FocusRGB/FocusRGB</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FocusRgb.Contracts\FocusRgb.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\spec\*.json" Pack="true" PackagePath="contentFiles\any\any\schemas" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
